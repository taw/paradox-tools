#!/usr/bin/env ruby

require_relative "./eu4_save_analysis"

class BestCourthousePlaces < EU4SaveAnalysis
  # Macro builder in game is doing a good job with it
  # about the only excption is colonial nations vs other subjects - you want to spam them in non-CN subjects as they'll get annexed eventually
  # but there's no point in spamming them in CNs
  def report_court_houses_and_town_halls
    courthouses = []
    town_halls = []

    # This is capped linear, so really very little logic is required
    #
    # * it ignores that cap is 1% not 0% (almost always doesn't matter)
    # * this is wrong for Merchant Republics as they have trade company vs territory cap backwards
    # * this is wrong for capital state (where discount is -100%)
    #
    # Pirate republics +75% cost does not change this logic
    # Statehouse's -20%/-40% only changes this logic if in territory/trade company

    @save.provinces.each do |id, province|
      next unless province.owner

      name = province.name

      if province.owner == @save.player_tag
        # OK
      elsif @save.players_subject?(province.owner)
        next if @save.colonial_nation?(province.owner)
        # OK
        name += " [#{country_name(province.owner)}]"
      else
        next
      end

      has_courthouse = province.buildings.include?("courthouse")
      has_town_hall = province.buildings.include?("town_hall")
      dev = province.development
      dev = dev.to_i if dev == dev.to_i

      # Has it all, we're done
      next if has_town_hall

      # Worth it everywhere
      unless has_courthouse
        courthouses << [dev, name]
      end

      # Will hit cap for Town Hall
      next if province.territory? and not province.trade_company?

      unless province.buildings.include?("town_hall")
        town_halls << [dev, name]
      end
    end

    puts "Courthouses to build:"
    courthouses.sort_by{|d,n| [-d,n]}.each do |row|
      puts row.join("\t")
    end

    puts "", "Town Halls to build:"
    town_halls.sort_by{|d,n| [-d,n]}.each do |row|
      puts row.join("\t")
    end
  end

  def provinces_to_areas
    unless @provinces_to_areas
      @provinces_to_areas = {}
      path = resolve("map/area.txt")
      data = path.read.gsub(/^\s*color\s*=\s*\{[^{}]*\}\s*$/, "")
      ParadoxModFile.new(string: data, path: path).parse!.each do |area_name, province_ids|
        province_ids.each do |province_id|
          @provinces_to_areas[province_id] = area_name
        end
      end
    end
    @provinces_to_areas
  end

  # Assume every owner province in state is full cored
  # (if it's recently conquered, it might not be yet, but we're optimizing for final situation)
  # don't include unowned provinces
  def each_player_state
    player_state_names = @save.country_states[@save.player_tag].to_set
    player_states = {}

    @save.provinces.each do |id, province|
      next unless province.owner == @save.player_tag
      area_name = provinces_to_areas[id]
      next unless player_state_names.include?(area_name)
      player_states[area_name] ||= []
      player_states[area_name] << province
    end

    player_states.each do |state_name, provinces|
      yield(state_name, provinces)
    end
  end

  def report_state_houses
    state_house_bonus_goods = %w[paper glass gems]
    capital_province_id = @save.player_country.capital_province_id

    each_player_state do |state_name, provinces|
      # capital state always costs 0 gov cap
      next if provinces.any?{|x| x.id == capital_province_id}

      # there could be valid reasons to build more than one (like with 2 gold mines in same province)
      # but let's keep this simple
      next if provinces.any?{|p| p.buildings.include?("state_house") }

      # Fully stated, assume town halls are build everywhere already (if not, build them first before doing state houses)
      current_gov_cap_cost = provinces.map(&:development).sum * 0.50

      # Now that we have list of states, we need to actually do calculations
      p [state_name, provinces, current_gov_cap_cost]
    end
  end

  def call
    report_court_houses_and_town_halls
    report_state_houses
  end
end

if $0 == __FILE__
  BestCourthousePlaces.new_from_argv.call
end
