#!/usr/bin/env ruby

require_relative "./eu4_save_analysis"

class RomanRestorationProgress < EU4SaveAnalysis
  def regions_to_areas
    @regions_to_areas ||= parse("map/region.txt").to_h.transform_values do |region|
      region["areas"]
    end
  end

  def areas_to_provinces
    @areas_to_provinces ||= begin
      path = resolve("map/area.txt")
      data = path.read.gsub(/^\s*color\s*=\s*\{[^{}]*\}\s*$/, "")
      ParadoxModFile.new(string: data, path: path).parse!.to_h.transform_values do |provinces|
        provinces.is_a?(PropertyList) ? [] : provinces
      end
    end
  end

  def roman_empire_trigger
    @roman_empire_trigger ||= parse("common/scripted_triggers/02_scripted_triggers_for_mission_conditions.txt")["BYZ_roman_empire_decision_trigger"]
  end

  def roman_provinces
    @roman_provinces ||= begin
      regions = roman_empire_trigger["OR"].find_all("region")
      areas = roman_empire_trigger["OR"].find_all("area") + regions.flat_map{ regions_to_areas[_1] }
      provinces = roman_empire_trigger["OR"].find_all("province_id") + areas.flat_map{ areas_to_provinces[_1] }
      remove_provinces = roman_empire_trigger.find_all("NOT").flat_map{|prop| areas_to_provinces[prop["area"]]}
      (provinces - remove_provinces).to_set
    end
  end

  def roman_provinces_by_owner
    unless @roman_provinces_by_owner
      @roman_provinces_by_owner = Hash.new(0)
      @save.provinces.each do |id, province|
        next unless roman_provinces.include?(id)
        @roman_provinces_by_owner[province.owner] += 1
      end
    end
    @roman_provinces_by_owner
  end

  # A subject's land is credited only to the top-level overlord, rather than to
  # each country along a subject chain.
  def ultimate_overlord(tag)
    seen = Set.new
    while (subject = @save.subjects[tag]) && !seen.include?(tag)
      seen << tag
      tag = subject[0]
    end
    tag
  end

  def roman_provinces_by_top_level_overlord
    @roman_provinces_by_top_level_overlord ||= begin
      totals = Hash.new(0)
      roman_provinces_by_owner.each do |tag, count|
        totals[ultimate_overlord(tag)] += count
      end
      totals
    end
  end

  def call
    base_counts = roman_provinces_by_owner
    total_counts = roman_provinces_by_top_level_overlord
    (base_counts.keys | total_counts.keys).map do |tag|
      total_count = total_counts.key?(tag) ? total_counts[tag] : base_counts[tag]
      [base_counts[tag], total_count, country_name(tag)]
    end.sort_by{|base_count, total_count, name| [-total_count, -base_count, name] }.each do |base_count, total_count, name|
      count = total_count == base_count ? base_count : "#{base_count} (#{total_count})"
      puts "#{name}: #{count}"
    end
  end
end

if $0 == __FILE__
  RomanRestorationProgress.new_from_argv.call
end
