#!/usr/bin/env ruby

require_relative "./eu4_save_analysis"

class AnalyzeTrade < EU4SaveAnalysis
  def best_outgoing_node_for(tag, node_tag)
    @save.game.trade_node_graph[node_tag].max_by do |outgoing_node_tag|
      @save.trade_network.nodes[outgoing_node_tag].total_collector_share[tag] || 0.0
    end
  end

  def print_node_info(node_name, node)
    node
      .total_collector_share
      .map{|tag, share| [country_name(tag), share]}
      .sort_by{|name, share| [-share, name]}
      .each do |name, share|
        puts "#{localization(node_name)} - #{name} - #{"%.6f" % share}"
      end
    puts ""
  end

  # This isn't really all that useful
  def print_trade_by_node
    @save.trade_network.nodes.each do |name, node|
      print_node_info(name, node)
    end
  end

  def print_trade_by_country
    by_country = {}
    @save.trade_network.nodes.each do |node_tag, node|
      node_name = localization(node_tag)
      node.total_collector_share.each do |tag, share|
        country_name = @save.countries[tag].name || localization(tag)
        by_country[tag] ||= {name: country_name, shares: []}
        by_country[tag][:shares] << [node_tag, node_name, share, node.merchant_actions[tag]]
      end

      # puts node_name
      # pp node.merchant_actions
    end
    by_country.sort_by{|tag, country| [-country[:shares].map{|x| x[2]}.sum, country[:name]]}.each do |tag, country|
      puts "#{country[:name]}:"
      country[:shares].sort_by{|node_tag, name, share, action| [-share, name]}.each do |node_tag, name, share, action|
        if action
          if action == :collect
            action_fmt = " - collect"
          else
            action_fmt = " - #{localization(action)}"
            outgoing_nodes = @save.game.trade_node_graph[node_tag]
            best_node = best_outgoing_node_for(tag, node_tag)
            selected_share = @save.trade_network.nodes[action].total_collector_share[tag] || 0.0
            best_share = @save.trade_network.nodes[best_node].total_collector_share[tag] || 0.0
            if best_share > selected_share
              action_fmt += " (better: #{localization(best_node)})"
            end
          end
        elsif (outgoing_nodes = @save.game.trade_node_graph[node_tag]).size > 1
          best_node = best_outgoing_node_for(tag, node_tag)
          action_fmt = " (best: #{localization(best_node)})"
        end
        puts "* #{name} - #{"%.6f" % share}#{action_fmt}"
      end
      puts ""
    end
  end

  def call
    print_trade_by_country
  end
end

if $0 == __FILE__
  AnalyzeTrade.new_from_argv.call
end
