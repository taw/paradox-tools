#!/usr/bin/env ruby

require_relative "./eu4_save_analysis"

# It used to be possible to calculate it, but min_autonomy is now quite complex
# Just take data from save, it's probably good enough
class AnalyzeAutonomy < EU4SaveAnalysis
  def call
     @save.countries.values.select(&:on_map?).map{|c| [country_name(c.tag), c.average_autonomy] }.sort.each do |name, avg_autonomy|
      puts "#{name}\t#{avg_autonomy}"
    end
  end
end

if $0 == __FILE__
  AnalyzeAutonomy.new_from_argv.call
end
